# IP printed by the XIAO's `wifi` serial command.
ITO_DEVICE_URL=http://192.168.1.100
# Same 32+ character secret as ITO_WIFI_TOKEN in wifi_local.h. Never NEXT_PUBLIC_.
ITO_DEVICE_TOKEN=replace-with-your-random-token
# Explicit demo only; never automatically substitutes simulated readings.
ITO_DEMO=false
