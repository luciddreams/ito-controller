ITO_TRANSPORT=mqtt
ITO_DEMO=false
# Broker must listen on an address reachable from Docker, not only 127.0.0.1.
# For an existing broker container, use its service name on a shared Docker network.
ITO_MQTT_URL=mqtt://host.docker.internal:1883
ITO_MQTT_TOPIC=ito/controller-01/telemetry
ITO_MQTT_USER=ito-dashboard
ITO_MQTT_PASSWORD=SET_LOCALLY
